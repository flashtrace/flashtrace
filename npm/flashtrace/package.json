{
  "name": "flashtrace",
  "version": "0.0.0",
  "description": "Lightning-fast, reference-based requirement tracing that works anywhere.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flashtrace/flashtrace.git"
  },
  "homepage": "https://github.com/flashtrace/flashtrace#readme",
  "bugs": "https://github.com/flashtrace/flashtrace/issues",
  "keywords": [
    "requirements",
    "traceability",
    "tracing",
    "coverage",
    "markdown",
    "cli"
  ],
  "bin": {
    "flashtrace": "bin/flashtrace.js"
  },
  "files": [
    "bin/"
  ],
  "scripts": {
    "prepack": "node -e \"require('node:fs').copyFileSync('../../README.md', 'README.md')\""
  },
  "engines": {
    "node": ">=18"
  },
  "optionalDependencies": {
    "@flashtrace/darwin-arm64": "0.0.0",
    "@flashtrace/darwin-x64": "0.0.0",
    "@flashtrace/linux-arm64": "0.0.0",
    "@flashtrace/linux-x64": "0.0.0",
    "@flashtrace/win32-arm64": "0.0.0",
    "@flashtrace/win32-x64": "0.0.0"
  }
}
