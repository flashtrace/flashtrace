{
  "name": "flashtrace",
  "version": "0.9.0",
  "description": "Lightning-fast, reference-based requirement tracing that works anywhere.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/flashtrace/flashtrace.git"
  },
  "homepage": "https://github.com/flashtrace/flashtrace#readme",
  "bugs": "https://github.com/flashtrace/flashtrace/issues",
  "keywords": [
    "requirements",
    "traceability",
    "tracing",
    "coverage",
    "markdown",
    "cli"
  ],
  "type": "module",
  "packageManager": "pnpm@11.10.0",
  "bin": {
    "flashtrace": "./dist/flashtrace.mjs"
  },
  "files": [
    "dist/"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "esbuild src/main.mjs --bundle --format=esm --platform=node --outfile=dist/flashtrace.mjs",
    "prepack": "pnpm run build",
    "pretest": "pnpm run build",
    "test": "node --test"
  },
  "devDependencies": {
    "esbuild": "^0.28.1"
  }
}
